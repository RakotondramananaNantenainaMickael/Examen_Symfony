{% extends "base.html.twig" %}

{% block title %}Dashboard - Gestion des Etudiants{% endblock %}

{% block body %}
    <div class="stats-grid">
        <div class="stat-card">
            <div class="number"> {{ totalStudents }} </div>
            <div class="label"> Etudiants</div>
        </div>
        <div class="stat-card">
            <div class="number"> {{ classrooms|length }} </div>
            <div class="label">Classes</div>
        </div>
    </div>

    <div class="card">
        <h2>Répartition par classe</h2>
        <div style="display: flex; flex-wrap: wrap; gap: 20px; margin-top: 20px">
            {% for classroom, count in studentsByClass %}
                <div style="flex: 1; min-width: 100px; background: #f7fafc; padding: 15px; border-radius: 12px; text-align: center;">
                    <div style="font-weight: 600; color: #2d3748;">{{ classroom }}</div>
                    <div style="font-size: 1.5rem; font-weight: 700; color: #667eea;">{{ count }}</div>
                </div>
            {% endfor %}
        </div>
    </div>
    <div class="card">
        <h2><i class="fas fa-clock"></i> Derniers inscrits</h2>
        {% if recentStudents|length > 0 %}
            <table class="table">
                <thead>
                    <tr>
                        <th>Prénom</th>
                        <th>Nom</th>
                        <th>Classe</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    {% for student in recentStudents %}
                        <tr>
                            <td>{{ student.firstName }}</td>
                            <td>{{ student.lastName }}</td>
                            <td><span class="badge badge-primary">{{ student.classroom }}</span></td>
                            <td>{{ student.createdAt|date('d/m/Y H:i') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p style="color: #718096; text-align: center;">Aucun étudiant inscrit pour le moment.</p>
        {% endif %}
    </div>

    <div style="text-align: center; margin-top: 20px;">
        <a href="{{ path('app_dashboard_students') }}" class="btn btn-primary">
            Voir tous les étudiants
        </a>
        <a href="{{ path('app_dashboard_student_new') }}" class="btn btn-success">
            Ajouter un étudiant
        </a>
    </div>

{% endblock %}